# MicBoard auf dem Webspace
DirectoryIndex index.html index.php
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  # https erzwingen (zweite Bedingung für Hoster hinter einem Proxy, z. B. IONOS)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  # Daten, Demo-Vorlage und Server-Dateien sind nicht abrufbar
  RewriteRule ^(daten|demo)(/|$) - [F]
  RewriteRule ^server\.mjs$ - [F]
  # Anmelde-Kopf an PHP weiterreichen (manche Hoster verschlucken ihn sonst)
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
